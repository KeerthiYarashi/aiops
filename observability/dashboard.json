{
  "title": "Verify Ops Monitoring",
  "uid": "verify-ops-monitoring",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 5,
      "title": "App availability",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "verify-ops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"verify-ops\"})",
          "legendFormat": "API"
        }
      ]
    },
    {
      "id": 7,
      "title": "Catalog call latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "verify-ops-prometheus"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 9,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(downstream_call_duration_seconds_sum{job=\"verify-ops\"}[$__rate_interval])) / sum(rate(downstream_call_duration_seconds_count{job=\"verify-ops\"}[$__rate_interval]))",
          "legendFormat": "mean"
        }
      ]
    },
    {
      "id": 4,
      "title": "Catalog error rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "verify-ops-prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 10,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(downstream_calls_total{job=\"verify-ops\",dependency=\"catalog-service\",outcome=\"error\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "errors/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "reqps"
        }
      }
    },
    {
      "id": 9,
      "title": "API process CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "verify-ops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(process_cpu_seconds_total{job=\"verify-ops\"}[$__rate_interval]))",
          "legendFormat": "CPU cores"
        }
      ]
    },
    {
      "id": 10,
      "title": "API resident memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "verify-ops-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(process_resident_memory_bytes{job=\"verify-ops\"})",
          "legendFormat": "RSS"
        }
      ]
    },
    {
      "id": 6,
      "title": "Item request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "verify-ops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_total{job=\"verify-ops\",endpoint=~\"/items.*\"}[$__rate_interval]))",
          "legendFormat": "requests/s"
        }
      ]
    },
    {
      "id": 1,
      "title": "Item HTTP response rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "verify-ops-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint,http_status) (rate(http_request_total{job=\"verify-ops\",endpoint=~\"/items.*\"}[$__rate_interval]))",
          "legendFormat": "{{endpoint}} {{http_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "reqps"
        }
      }
    },
    {
      "id": 11,
      "title": "Average item-read latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "verify-ops-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_duration_seconds_sum{job=\"verify-ops\",method=\"GET\",endpoint=\"/items/{item_id}\"}[$__rate_interval])) / sum(rate(http_request_duration_seconds_count{job=\"verify-ops\",method=\"GET\",endpoint=\"/items/{item_id}\"}[$__rate_interval]))",
          "legendFormat": "mean"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 8,
      "title": "Redis operation latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "verify-ops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(redis_request_duration_seconds_sum{job=\"verify-ops\"}[$__rate_interval])) / sum(rate(redis_request_duration_seconds_count{job=\"verify-ops\"}[$__rate_interval]))",
          "legendFormat": "mean"
        }
      ]
    },
    {
      "id": 3,
      "title": "Redis cache hits, misses and errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "verify-ops-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(cache_request_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "Item read p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "verify-ops-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{endpoint=\"/items/{item_id}\",method=\"GET\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s"
        }
      }
    }
  ]
}
